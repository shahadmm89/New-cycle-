node_modules/
.cache/
.remotion/
*.log

# Neural voice model (~63 MB). Fetched on demand by scripts/build-voiceover.mjs
assets/tts/voices/

# Per-line narration takes. Re-created by `npm run voiceover:build`;
# the assembled assets/audio/voiceover.wav is committed instead.
assets/audio/lines/

# Review frames only - the rendered MP4s in output/ are committed.
output/stills/
assets/tts/kokoro/

# Python bytecode from the analysis scripts.
__pycache__/

# The asset package is a build output, not source: every part of it is
# regenerated by `npm run export:package`, `export:stills` and
# `export:elements`. The heavy parts stay out of git; the light ones that are
# useful to read in a diff (the script, the guides, the captions) are kept.
output/asset-package/02_audio/
output/asset-package/03_scenes/
output/asset-package/04_elements/*/*.zip
# The shippable bundles - built on demand by `export:package --only=bundle`,
# derived entirely from output/asset-package/, and over GitHub's file limit.
output/*.zip
output/parts/

# Scratch: how a partial `--only=` run of the exporter hands its results to a
# later one. The guide step deletes it, so it only survives a partial build.
output/asset-package/_manifest.partial.json
